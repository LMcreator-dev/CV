---
interface Props {
  name: string;
  issuer: string;
  date?: string;
  image: string;
  credentialUrl?: string;
  devops?: boolean;
  inProgress?: boolean;
  description?: string;
  attendance?: boolean;
}

const { name, issuer, date, image, credentialUrl, devops = false, inProgress = false, description, attendance = false } = Astro.props;
const hasCredentialUrl = Boolean(credentialUrl?.trim());
const showFullImage = !hasCredentialUrl;
---

<article class:list={["card cert-card", { "cert-card--full-image": showFullImage, "devops-highlight": devops }]}>
  <div class="cert-badge">
    <a
      class="cert-image-link"
      href={image}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`Abrir imagen completa de la certificación ${name}`}
    >
      <img
        class="cert-image"
        src={image}
        alt={name}
        loading="eager"
        decoding="async"
        width="120"
        height="120"
        onerror="this.onerror=null;this.src='/certifications/cert-fallback.svg';"
      />
    </a>
  </div>
  <div class="cert-body">
    <div>
      {devops && <span class="devops-label">Sistemas / DevOps</span>}
      <span class="cert-issuer">{issuer}</span>
      <h3>{name}</h3>
      {date && <p class="cert-date">{date}</p>}
      {attendance && <p class="cert-date">Seminario · Asistencia</p>}
      {inProgress && <span class="devops-label">En curso</span>}
      {description && <p class="cert-description">{description}</p>}
    </div>

    {hasCredentialUrl ? (
      <a href={credentialUrl} target="_blank" rel="noopener noreferrer" class="button button-link">
        Ver credencial
      </a>
    ) : !inProgress && !attendance && (
      <a href={image} target="_blank" rel="noopener noreferrer" class="button button-link">
        Ver documento
      </a>
    )}
  </div>
</article>
