---
import SectionHeading from "./ui/SectionHeading.astro";
import CertificationCard from "./ui/CertificationCard.astro";
import type { Certification } from "../data/cv";

interface Props {
  title: string;
  certifications: Certification[];
}

const { title, certifications } = Astro.props;
const groupOrder = [
  "Estudios",
  "Sistemas / DevOps / Observabilidad",
  "Seminarios",
] as const;

const groupedCertifications = groupOrder
  .map((group) => ({
    group,
    items: certifications.filter((cert) => cert.group === group),
  }))
  .filter((entry) => entry.items.length > 0);
---

<section class="section section-alt" id="certifications">
  <div class="container">
    <SectionHeading
      title={title}
      align="center"
      eyebrow=""
    />
    <div class="cert-groups">
      {groupedCertifications.map((entry) => (
        <details class:list={["cert-group", { "devops-highlight": entry.group === "Sistemas / DevOps / Observabilidad" }]}>
          <summary class="cert-group-heading group-summary">
            <h3>{entry.group}</h3>
            <span>{entry.items.length} {entry.group === "Estudios" ? "estudios" : entry.group === "Seminarios" ? "asistencias" : "credenciales"}</span>
          </summary>

          <div class="cert-grid">
            {entry.items.map((cert) => (
              <CertificationCard {...cert} devops={cert.devops || entry.group === "Sistemas / DevOps / Observabilidad"} />
            ))}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
