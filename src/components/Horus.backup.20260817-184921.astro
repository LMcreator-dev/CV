   *   papers: [],
   *
   *   evidence: [],
   *
   *   notes: "",
   *
   * },
   */


};


/* ============================================================
   OBTENER REGISTRO
   ============================================================ */

const getRecord = (
  code: string
): HorusRecord => {

  const record = HORUS_RECORDS[code];

  return {
    ...EMPTY_RECORD(),

    ...(record ?? {}),

    study: {
      ...EMPTY_RECORD().study,
      ...(record?.study ?? {}),
    },

    resources:
      record?.resources ?? [],

    exercises:
      record?.exercises ?? [],

    exams:
      record?.exams ?? [],

    projects:
      record?.projects ?? [],

    courses:
      record?.courses ?? [],

    certifications:
      record?.certifications ?? [],

    papers:
      record?.papers ?? [],

    evidence:
      record?.evidence ?? [],

    notes:
      record?.notes ?? "",
  };
};


