<script>
  /*
   * Persistencia local de las casillas del índice.
   *
   * Esto NO convierte las casillas en una prueba de conocimiento.
   * Solamente permite que tú marques qué has estudiado.
   * La evaluación académica real se añadirá posteriormente.
   */

  const STORAGE_KEY = "horus-study-index-v1";
  const root = document.querySelector("#horus");

  if (root) {
    const checks = Array.from(
      root.querySelectorAll<HTMLInputElement>("[data-horus-check]")
    );

    const loadState = () => {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);

        if (!raw) return;

        const saved = JSON.parse(raw) as string[];

        checks.forEach((check, index) => {
          check.checked = saved.includes(String(index));
          check.closest(".horus-item")?.classList.toggle(
            "is-complete",
            check.checked
          );
        });
      } catch {
        // Si localStorage está bloqueado o contiene datos corruptos,
        // HORUS sigue funcionando normalmente.
      }
    };

    const saveState = () => {
      const saved = checks
        .map((check, index) => (check.checked ? String(index) : null))
        .filter((value): value is string => value !== null);

      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(saved));
      } catch {
        // No bloquear la interfaz por un problema de persistencia.
      }
    };

    checks.forEach((check) => {
      check.addEventListener("change", () => {
        check.closest(".horus-item")?.classList.toggle(
          "is-complete",
          check.checked
        );

        saveState();
      });
    });

    loadState();
  }
</script>

