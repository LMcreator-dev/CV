---
import SectionHeading from "./ui/SectionHeading.astro";
import CertificationCard from "./ui/CertificationCard.astro";

interface Cert {
  name: string;
  issuer: string;
  date: string;
  image: string;
  credentialUrl?: string;
  group?:
    | "Sistemas / DevOps / Observabilidad"
    | "Redes y Ciberseguridad"
    | "Automatización y Desarrollo"
    | "Estudios añadidos";
}

interface Props {
  title: string;
  certifications: Cert[];
}

const { title, certifications } = Astro.props;
const groupOrder = [
  "Sistemas / DevOps / Observabilidad",
  "Redes y Ciberseguridad",
  "Automatización y Desarrollo",
  "Estudios añadidos",
] as const;

const getGroup = (cert: Cert) => {
  if (cert.group) return cert.group;
  if (["Docker", "Andel"].includes(cert.issuer)) return "Sistemas / DevOps / Observabilidad";
  if (["Cisco"].includes(cert.issuer)) return "Redes y Ciberseguridad";
  if (["DataCamp", "Microsoft", "Santander Open Academy"].includes(cert.issuer)) return "Automatización y Desarrollo";
  return "Estudios añadidos";
};

const groupedCertifications = groupOrder
  .map((group) => ({
    group,
    items: certifications.filter((cert) => getGroup(cert) === group),
  }))
  .filter((entry) => entry.items.length > 0);
---

<section class="section section-alt" id="certifications">
  <div class="container">
    <SectionHeading
      title={title}
      intro="Credenciales agrupadas por foco profesional y formación complementaria."
      align="center"
      eyebrow="Aprendizaje"
    />
    <div class="cert-groups">
      {groupedCertifications.map((entry) => (
        <section class="cert-group">
          <header class="cert-group-heading">
            <h3>{entry.group}</h3>
            <span>{entry.items.length} credenciales</span>
          </header>

          <div class="cert-grid">
            {entry.items.map((cert) => (
              <CertificationCard {...cert} />
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>
</section>
