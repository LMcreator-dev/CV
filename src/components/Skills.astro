---
import SectionHeading from "./ui/SectionHeading.astro";
import SkillCard from "./ui/SkillCard.astro";

interface Knowledge {
  name: string;
  level: 1 | 2 | 3 | 4;
  group:
    | "Sistemas, DevOps y Automatización"
    | "HORUS / IA"
    | "Técnica Industrial"
    | "Monitoring y Observabilidad"
    | "Infraestructura, Redes y Seguridad"
    | "Gestión y Comunicación"
    | "Capacidades Profesionales";
  description: string;
}

interface Props {
  title: string;
  knowledge: Knowledge[];
}

const { title, knowledge } = Astro.props;
const groupOrder = [
  "Sistemas, DevOps y Automatización",
  "Monitoring y Observabilidad",
  "Infraestructura, Redes y Seguridad",
  "Gestión y Comunicación",
  "Capacidades Profesionales",
  "HORUS / IA",
  "Técnica Industrial",
] as const;

const groupedKnowledge = groupOrder
  .map((group) => ({
    group,
    items: knowledge
      .filter((item) => item.group === group)
      .sort((a, b) => a.name.localeCompare(b.name, "es")),
  }))
  .filter((entry) => entry.items.length > 0);
---

<section class="section section-alt" id="skills">
  <div class="container">
    <SectionHeading
      title={title}
      intro="Competencias orientadas a operación de sistemas, automatización, monitorización y soporte de infraestructura."
      align="center"
      eyebrow="Conocimientos"
    />
    <div class="knowledge-groups">
      {groupedKnowledge.map((entry) => (
        <section class="knowledge-group">
          <header class="knowledge-group-heading">
            <h3>{entry.group}</h3>
          </header>
          <div class="skills-grid">
            {entry.items.map((item) => (
              <SkillCard {...item} />
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>
</section>
