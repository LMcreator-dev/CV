---
interface Props {
  name: string;
  level: 1 | 2 | 3 | 4;
  description: string;
  group?: string;
}

const { name, level, description, group } = Astro.props;
const levelLabels = {
  1: "Base",
  2: "Operativo",
  3: "Avanzado",
  4: "Especialista",
} as const;

const isHorus = group === "HORUS / IA";
---

<details class:list={["card card-skill", isHorus && "card-skill-horus"]}>
  <summary class="knowledge-heading">
    <h3>{name}</h3>
    <span>{levelLabels[level]}</span>
  </summary>

  <p>{description}</p>

</details>
