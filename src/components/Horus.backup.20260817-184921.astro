/*
 * ============================================================
 *                       PROJECT HORUS
 *             AI MASTERY & RESEARCH TRACK
 * ============================================================
 *
 * HORUS ES:
 *
 *   1. Un índice maestro de estudio.
 *   2. Un expediente público de progreso.
 *   3. Un registro de ejercicios/proyectos/evidencias.
 *   4. Un historial de formación.
 *
 * FUENTE DE VERDAD:
 *
 *   ESTE ARCHIVO.
 *
 * La web NO es editable.
 * Las casillas NO existen.
 * No se utiliza localStorage.
 *
 * Para actualizar HORUS:
 *
 *   1. Estudias.
 *   2. Practicas.
 *   3. Haces ejercicios.
 *   4. Realizas la evaluación que corresponda.
 *   5. Generas evidencia.
 *   6. Modificas HORUS_RECORDS.
 *   7. git commit
 *   8. git push
 *
 * ============================================================
 */


/* ============================================================
   TIPOS
   ============================================================ */

type StudyStatus =
  | "not-started"
  | "in-progress"
  | "completed"
  | "review";

type EvidenceType =
  | "resource"
  | "exercise"
  | "exam"
  | "project"
  | "repository"
  | "course"
  | "certification"
  | "paper"
  | "report"
  | "research"
  | "other";

type Evidence = {
  id: string;
  type: EvidenceType;
  title: string;
  url?: string;
  description?: string;
  date?: string;
  score?: number;
};

type StudyInfo = {
  status: StudyStatus;
  startedAt: string;
  completedAt: string;
  hours: number;
};

type HorusRecord = {
  completed: boolean;

  /*
   * 0 = No conocido
   * 1 = Familiaridad
   * 2 = Comprensión
   * 3 = Implementación
   * 4 = Dominio
   * 5 = Investigación
   */
  level: 0 | 1 | 2 | 3 | 4 | 5;

  study: StudyInfo;

  resources: Evidence[];
  exercises: Evidence[];
  exams: Evidence[];
  projects: Evidence[];
  courses: Evidence[];
  certifications: Evidence[];
  papers: Evidence[];
  evidence: Evidence[];

  notes: string;
};

type CurriculumItem = {
  code: string;
  title: string;
};

type Topic = {
  code: string;
  title: string;
  items: CurriculumItem[];
};

type Subject = {
  code: string;
  title: string;
  description: string;
  topics: Topic[];
  resources: Evidence[];
};

type Stage = {
  code: string;
  title: string;
  subtitle: string;
  description: string;
  subjects: Subject[];
};


/* ============================================================
   HELPERS
   ============================================================ */

const resource = (
  id: string,
  title: string,
  type: EvidenceType,
  url: string,
  description = ""
): Evidence => ({
  id,
  type,
  title,
  url,
  description,
});


const topic = (
  code: string,
  title: string,
  items: string[]
): Topic => ({
  code,
  title,

  items: items.map((title, index) => ({
    code: `${code}.${String(index + 1).padStart(2, "0")}`,
    title,
  })),
});


/*
 * Cada elemento del currículo comienza automáticamente con:
 *
 * completed: false
 * level: 0
 * study vacío
 * resources []
 * exercises []
 * exams []
 * projects []
 * courses []
 * certifications []
 * papers []
 * evidence []
 * notes ""
 *
 * NO necesitas repetir esta estructura cientos de veces.
 */


const EMPTY_RECORD = (): HorusRecord => ({
  completed: false,

  level: 0,

  study: {
    status: "not-started",
    startedAt: "",
    completedAt: "",
    hours: 0,
  },

  resources: [],
  exercises: [],
  exams: [],
  projects: [],
  courses: [],
  certifications: [],
  papers: [],
  evidence: [],

  notes: "",
});


