/* ============================================================
   ESTADÍSTICAS
   ============================================================ */

const allItems = stages.flatMap((stage) =>
  stage.subjects.flatMap((subject) =>
    subject.topics.flatMap((topic) =>
      topic.items.map((item) => ({
        ...item,
        record: getRecord(item.code),
      }))
    )
  )
);

const totalItems = allItems.length;

const totalCompleted = allItems.filter(
  (item) => item.record.completed
).length;

const globalProgress =
  totalItems === 0
    ? 0
    : Math.round(
        (totalCompleted / totalItems) * 100
      );

const totalSubjects = stages.reduce(
  (total, stage) =>
    total + stage.subjects.length,
  0
);

const totalTopics = stages.reduce(
  (total, stage) =>
    total +
    stage.subjects.reduce(
      (subjectTotal, subject) =>
        subjectTotal + subject.topics.length,
      0
    ),
  0
);


const getTopicProgress = (
  topic: Topic
) => {

  const completed = topic.items.filter(
    (item) =>
      getRecord(item.code).completed
  ).length;

  return topic.items.length === 0
    ? 0
    : Math.round(
        (completed / topic.items.length) * 100
      );
};


const getSubjectProgress = (
  subject: Subject
) => {

  const items =
    subject.topics.flatMap(
      (topic) => topic.items
    );

  const completed = items.filter(
    (item) =>
      getRecord(item.code).completed
  ).length;

  return items.length === 0
    ? 0
    : Math.round(
        (completed / items.length) * 100
      );
};


const getStageProgress = (
  stage: Stage
) => {

  const items =
    stage.subjects.flatMap(
      (subject) =>
        subject.topics.flatMap(
          (topic) => topic.items
        )
    );

  const completed =
    items.filter(
      (item) =>
        getRecord(item.code).completed
    ).length;

  return items.length === 0
    ? 0
    : Math.round(
        (completed / items.length) * 100
      );
};


const getEvidenceCount = (
  record: HorusRecord
) =>
  record.resources.length +
  record.exercises.length +
  record.exams.length +
  record.projects.length +
  record.courses.length +
  record.certifications.length +
  record.papers.length +
  record.evidence.length;


const getAllEvidence = (
  record: HorusRecord
): Evidence[] => [
  ...record.resources,
  ...record.exercises,
  ...record.exams,
  ...record.projects,
  ...record.courses,
  ...record.certifications,
  ...record.papers,
  ...record.evidence,
];


const levelNames = [
  "No conocido",
  "Familiaridad",
  "Comprensión",
  "Implementación",
  "Dominio",
  "Investigación",
];
---

<section
  id="horus"
  class="horus-section"
>

  <div class="horus-shell">

    <!-- ======================================================
         HERO
         ====================================================== -->

    <header class="horus-hero">

      <div>

        <p class="horus-kicker">
          PROJECT 
        </p>

        <h2>
          HORUS: AI Mastery &amp;
          Research Track
        </h2>

        <p class="horus-lead">

          Índice maestro de formación en
          Inteligencia Artificial desde los
          fundamentos de programación,
          matemáticas y Machine Learning hasta
          Deep Learning, Transformers, LLMs,
          sistemas de IA e investigación por Luis.

        </p>

        <div class="horus-tags">

          <span>Fundamentos</span>
          <span>Deep Learning</span>
          <span>Transformers</span>
          <span>LLMs</span>
          <span>AI Systems</span>
          <span>Research</span>

        </div>

      </div>


      <aside class="horus-current">

        <span>
          ESTADO
        </span>

        <strong>
          {globalProgress === 0
            ? "Inicio"
            : `${globalProgress}% completado`}
        </strong>

        <p>

          El estado público procede
          exclusivamente del código fuente
          de HORUS.

        </p>

      </aside>

    </header>


    <!-- ======================================================
         DASHBOARD
         ====================================================== -->

    <section class="horus-dashboard">

      <article class="horus-stat main">

        <span>
          PROGRESO GLOBAL
        </span>

        <strong>
          {globalProgress}%
        </strong>

        <div class="bar">
          <i
            style={`width:${globalProgress}%`}
          ></i>
        </div>

      </article>


      <article class="horus-stat">

        <span>
          CONCEPTOS
        </span>

        <strong>
          {totalItems}
        </strong>

        <small>
          elementos del currículo
        </small>

      </article>


      <article class="horus-stat">

        <span>
          MATERIAS
        </span>

        <strong>
          {totalSubjects}
        </strong>

        <small>
          bloques
        </small>

      </article>


      <article class="horus-stat">

        <span>
          UNIDADES
        </span>

        <strong>
          {totalTopics}
        </strong>

        <small>
          unidades de estudio
        </small>

      </article>

    </section>


    <!-- ======================================================
         MODELO
         ====================================================== -->

    <section class="horus-method">

      <div>

        <p class="horus-label">
          METODOLOGÍA
        </p>


      </div>


      <div class="horus-method-grid">

        <article>
          <b>01</b>
          <strong>Estudiar</strong>
          <span>
            Investigar específicamente cada concepto y memorizar.
          </span>
        </article>

        <article>
          <b>02</b>
          <strong>Practicar</strong>
          <span>
            Resolver problemas y ejercicios.
          </span>
        </article>

        <article>
          <b>03</b>
          <strong>Demostrar</strong>
          <span>
            Implementaciones, exámenes y proyectos.
          </span>
        </article>

        <article>
          <b>04</b>
          <strong>Registrar</strong>
          <span>
            Actualizar el expediente.
          </span>
        </article>

      </div>

    </section>


    <!-- ======================================================
         LEVELS
         ====================================================== -->

    <section class="horus-levels">

      <p class="horus-label">
        NIVELES DE DOMINIO
      </p>

      <div class="horus-level-grid">

        {levelNames.map(
          (name, index) => (

            <article>

              <b>
                {index}
              </b>

              <strong>
                {name}
              </strong>

              <p>

                {index === 0 &&
                  "Todavía no estudiado."}

                {index === 1 &&
                  "Reconoce el concepto."}

                {index === 2 &&
                  "Puede explicarlo y resolver ejercicios."}

                {index === 3 &&
                  "Puede implementarlo sin guía."}

                {index === 4 &&
                  "Puede resolver problemas nuevos."}

                {index === 5 &&
                  "Puede investigarlo o extenderlo."}

              </p>

            </article>

          )
        )}

      </div>

    </section>


    <!-- ======================================================
         ROADMAP
         ====================================================== -->

    <section class="horus-roadmap">

      <p class="horus-label">
        ROADMAP
      </p>

      <div class="roadmap-grid">

        {stages.map(
          (stage) => {

            const progress =
              getStageProgress(stage);

            return (

              <a
                href={`#horus-${stage.code}`}
                class="roadmap-card"
              >

                <span>
                  {stage.code}
                </span>

                <strong>
                  {stage.title}
                </strong>

                <p>
                  {stage.subtitle}
                </p>

                <div>
                  <i
                    style={`width:${progress}%`}
                  ></i>
                </div>

                <small>
                  {progress}%
                </small>

              </a>

            );

          }
        )}

      </div>

    </section>


    <!-- ======================================================
         CURRICULUM
         ====================================================== -->

    {stages.map(
      (stage) => {

        const stageProgress =
          getStageProgress(stage);

        return (

          <section
            id={`horus-${stage.code}`}
            class="horus-stage"
          >

            <!-- STAGE HEADER -->

            <header class="stage-header">

              <div class="stage-badge">
                {stage.code}
              </div>

              <div>

                <p class="horus-label">
                  {stage.title}
                </p>

                <h3>
                  {stage.subtitle}
                </h3>

                <p>
                  {stage.description}
                </p>

              </div>

              <div class="stage-progress">

                <span>
                  PROGRESO
                </span>

                <strong>
                  {stageProgress}%
                </strong>

                <div>
                  <i
                    style={`width:${stageProgress}%`}
                  ></i>
                </div>

              </div>

            </header>


            <!-- SUBJECTS -->

            {stage.subjects.map(
              (subject) => {

                const subjectProgress =
                  getSubjectProgress(subject);

                return (

                  <article class="subject">

                    <header class="subject-header">

                      <div>

                        <span>
                          {subject.code}
                        </span>

                        <h4>
                          {subject.title}
                        </h4>

                        <p>
                          {subject.description}
                        </p>

                      </div>

                      <strong>
                        {subjectProgress}%
                      </strong>

                    </header>


                    <!-- TOPICS -->

                    {subject.topics.map(
                      (topic) => {

                        const topicProgress =
                          getTopicProgress(topic);

                        return (

                          <details class="topic">

                            <summary>

                              <div>

                                <span>
                                  {topic.code}
                                </span>

                                <strong>
                                  {topic.title}
                                </strong>

                              </div>

                              <aside>

                                <small>
                                  {topic.items.length}
                                </small>

                                <b>
                                  {topicProgress}%
                                </b>

                                <i>
                                  +
                                </i>

                              </aside>

                            </summary>


                            <div class="items">

                              {topic.items.map(
                                (curriculumItem) => {

                                  const record =
                                    getRecord(
                                      curriculumItem.code
                                    );

                                  const evidence =
                                    getAllEvidence(record);

                                  return (

                                    <article
                                      class:list={[
                                        "item",
                                        record.completed
                                          ? "completed"
                                          : "pending",
                                      ]}
                                    >

                                      <!-- STATUS -->

                                      <div class="status">

                                        <span>

                                          {record.completed
                                            ? "✓"
                                            : "○"}

                                        </span>

                                      </div>


                                      <!-- CONTENT -->

                                      <div class="item-body">

                                        <div class="item-title">

                                          <code>
                                            {curriculumItem.code}
                                          </code>

                                          <strong>
                                            {curriculumItem.title}
                                          </strong>

                                        </div>


                                        <!-- METADATA -->

                                        {(
                                          record.completed ||
                                          record.level > 0 ||
                                          record.study.status !==
                                            "not-started" ||
                                          record.study.hours > 0 ||
                                          evidence.length > 0 ||
                                          record.notes
                                        ) && (

                                          <div class="metadata">

                                            {record.completed && (
                                              <span>
                                                ✓ Completado
                                              </span>
                                            )}

                                            {record.level > 0 && (
                                              <span>
                                                Nivel {record.level}/5
                                              </span>
                                            )}

                                            {record.study.status ===
                                              "in-progress" && (
                                              <span>
                                                En progreso
                                              </span>
                                            )}

                                            {record.study.status ===
                                              "review" && (
                                              <span>
                                                Revisar
                                              </span>
                                            )}

                                            {record.study.hours > 0 && (
                                              <span>
                                                {record.study.hours} h
                                              </span>
                                            )}

                                            {evidence.length > 0 && (
                                              <span>
                                                {evidence.length} evidencias
                                              </span>
                                            )}

                                          </div>

                                        )}


                                        <!-- STUDY PERIOD -->

                                        {(
                                          record.study.startedAt ||
                                          record.study.completedAt
                                        ) && (

                                          <div class="dates">

                                            {record.study.startedAt && (
                                              <span>
                                                Inicio:
                                                {" "}
                                                {record.study.startedAt}
                                              </span>
                                            )}

                                            {record.study.completedAt && (
                                              <span>
                                                Fin:
                                                {" "}
                                                {record.study.completedAt}
                                              </span>
                                            )}

                                          </div>

                                        )}


                                        <!-- EVIDENCE -->

                                        {evidence.length > 0 && (

                                          <div class="evidence">

                                            {evidence.map(
                                              (ev) => (

                                                <a
                                                  href={
                                                    ev.url ?? "#"
                                                  }
                                                  target={
                                                    ev.url
                                                      ? "_blank"
                                                      : undefined
                                                  }
                                                  rel={
                                                    ev.url
                                                      ? "noopener noreferrer"
                                                      : undefined
                                                  }
                                                >

                                                  <small>
                                                    {ev.type}
                                                  </small>

                                                  <span>
                                                    {ev.title}
                                                  </span>

                                                  {ev.score !==
                                                    undefined && (
                                                    <b>
                                                      {ev.score}%
                                                    </b>
                                                  )}

                                                </a>

                                              )
                                            )}

                                          </div>

                                        )}


                                        <!-- NOTES -->

                                        {record.notes && (

                                          <div class="notes">

