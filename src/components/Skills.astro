---
import SectionHeading from "./ui/SectionHeading.astro";
import SkillCard from "./ui/SkillCard.astro";

interface Knowledge {
  name: string;
  level: 1 | 2 | 3 | 4;
  group:
    | "Sistemas, DevOps y Automatización"
    | "HORUS / IA"
    | "Técnica Industrial"
    | "Monitoring y Observabilidad"
    | "Infraestructura, Redes y Seguridad"
    | "Gestión y Comunicación"
    | "Capacidades Profesionales";
  description: string;
}

interface Props {
  title: string;
  knowledge: Knowledge[];
}

const { title, knowledge } = Astro.props;
const groupOrder = [
  "Sistemas, DevOps y Automatización",
  "Monitoring y Observabilidad",
  "Infraestructura, Redes y Seguridad",
  "Gestión y Comunicación",
  "Capacidades Profesionales",
  "HORUS / IA",
  "Técnica Industrial",
] as const;

const groupedKnowledge = groupOrder
  .map((group) => ({
    group,
    devops: [
      "Sistemas, DevOps y Automatización",
      "Monitoring y Observabilidad",
      "Infraestructura, Redes y Seguridad",
    ].includes(group),
    items: knowledge
      .filter((item) => item.group === group)
      .sort((a, b) => a.name.localeCompare(b.name, "es")),
  }))
  .filter((entry) => entry.items.length > 0);
---

<section class="section section-alt" id="skills">
  <div class="container">
    <SectionHeading
      title={title}
      intro="Abre cada área para consultar las tecnologías y su nivel de dominio."
      align="center"
      eyebrow="Conocimientos"
    />
    <div class="knowledge-groups">
      {groupedKnowledge.map((entry) => (
        <details class:list={["knowledge-group", { "devops-highlight": entry.devops }]}>
          <summary class="knowledge-group-heading group-summary">
            <h3>{entry.group}</h3>
            <span class="group-count">{entry.items.length}</span>
            {entry.devops && (
              <span class="devops-label">DevOps</span>
            )}
          </summary>
          <div class="skills-grid">
            {entry.items.map((item) => (
              <SkillCard {...item} />
            ))}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
