---
import { HORUS } from "../data/horus";
import { HORUS_RECORDS } from "../data/horus/progress";
import { mergeRecord, getEvidence } from "../data/horus/helpers";

const levelNames = [
  "No conocido",
  "Familiaridad",
  "Comprensión",
  "Implementación",
  "Dominio",
  "Investigación",
];

const getRecord = (code: string) =>
  mergeRecord(HORUS_RECORDS[code]);

const getTopicProgress = (topic: any) => {
  const completed = topic.items.filter(
    (item: any) => getRecord(item.code).completed
  ).length;

  return topic.items.length
    ? Math.round((completed / topic.items.length) * 100)
    : 0;
};

const getSubjectProgress = (subject: any) => {
  const items = subject.topics.flatMap(
    (topic: any) => topic.items
  );

  const completed = items.filter(
    (item: any) => getRecord(item.code).completed
  ).length;

  return items.length
    ? Math.round((completed / items.length) * 100)
    : 0;
};

const getStageProgress = (stage: any) => {
  const items = stage.subjects.flatMap(
    (subject: any) =>
      subject.topics.flatMap(
        (topic: any) => topic.items
      )
  );

  const completed = items.filter(
    (item: any) => getRecord(item.code).completed
  ).length;

  return items.length
    ? Math.round((completed / items.length) * 100)
    : 0;
};

const allItems = HORUS.flatMap(
  (stage: any) =>
    stage.subjects.flatMap(
      (subject: any) =>
        subject.topics.flatMap(
          (topic: any) => topic.items
        )
    )
);

const totalItems = allItems.length;

const totalCompleted = allItems.filter(
  (item: any) => getRecord(item.code).completed
).length;

const globalProgress = totalItems
  ? Math.round((totalCompleted / totalItems) * 100)
  : 0;
---

<section id="horus" class="horus-section">
  <div class="horus-shell">

    <header class="horus-hero">

      <div>
        <p class="horus-kicker">PROJECT HORUS</p>

        <h2>
          AI Mastery &amp;
          Research Track
        </h2>

        <p class="horus-lead">
          Índice maestro de formación en Inteligencia Artificial,
          desde fundamentos hasta investigación.
        </p>
      </div>

      <aside class="horus-current">
        <span>ESTADO</span>

        <strong>
          {globalProgress}%
        </strong>

        <p>
          Progreso calculado automáticamente a partir
          del estado registrado en HORUS.
        </p>
      </aside>

    </header>


    <section class="horus-dashboard">

      <article class="horus-stat main">
        <span>PROGRESO GLOBAL</span>

        <strong>
          {globalProgress}%
        </strong>

        <div class="bar">
          <i
            style={`width:${globalProgress}%`}
          ></i>
        </div>
      </article>

      <article class="horus-stat">
        <span>CONCEPTOS</span>
        <strong>{totalItems}</strong>
        <small>ítems cargados</small>
      </article>

      <article class="horus-stat">
        <span>MATERIAS</span>
        <strong>
          {HORUS.reduce(
            (n: number, stage: any) =>
              n + stage.subjects.length,
            0
          )}
        </strong>
        <small>bloques</small>
      </article>

    </section>


    {HORUS.map((stage: any) => {

      const stageProgress =
        getStageProgress(stage);

      return (
        <section
          id={`horus-${stage.code}`}
          class="horus-stage"
        >

          <header class="stage-header">

            <div class="stage-badge">
              {stage.code}
            </div>

            <div>

              <p class="horus-label">
                {stage.title}
              </p>

              <h3>
                {stage.subtitle}
              </h3>

              <p>
                {stage.description}
              </p>

            </div>

            <div class="stage-progress">

              <span>PROGRESO</span>

              <strong>
                {stageProgress}%
              </strong>

              <div>
                <i
                  style={`width:${stageProgress}%`}
                ></i>
              </div>

            </div>

          </header>


          {stage.subjects.map(
            (subject: any) => {

              const subjectProgress =
                getSubjectProgress(subject);

              return (

                <article class="subject">

                  <header class="subject-header">

                    <div>

                      <span>
                        {subject.code}
                      </span>

                      <h4>
                        {subject.title}
                      </h4>

                      <p>
                        {subject.description}
                      </p>

                    </div>

                    <strong>
                      {subjectProgress}%
                    </strong>

                  </header>


                  {subject.topics.map(
                    (topic: any) => {

                      const topicProgress =
                        getTopicProgress(topic);

                      return (

                        <details class="topic">

                          <summary>

                            <div>

                              <span>
                                {topic.code}
                              </span>

                              <strong>
                                {topic.title}
                              </strong>

                            </div>

                            <aside>

                              <small>
                                {topic.items.length}
                              </small>

                              <b>
                                {topicProgress}%
                              </b>

                              <i>+</i>

                            </aside>

                          </summary>


                          <div class="items">

                            {topic.items.map(
                              (curriculumItem: any) => {

                                const record =
                                  getRecord(
                                    curriculumItem.code
                                  );

                                const evidence =
                                  getEvidence(record);

                                return (

                                  <article
                                    class:list={[
                                      "item",
                                      record.completed
                                        ? "completed"
                                        : "pending",
                                    ]}
                                  >

                                    <div class="status">
                                      <span>
                                        {record.completed
                                          ? "✓"
                                          : "○"}
                                      </span>
                                    </div>


                                    <div class="item-body">

                                      <div class="item-title">

                                        <code>
                                          {curriculumItem.code}
                                        </code>

                                        <strong>
                                          {curriculumItem.title}
                                        </strong>

                                      </div>


                                      {(
                                        record.completed ||
                                        record.level > 0 ||
                                        record.study.status !== "not-started" ||
                                        record.study.hours > 0 ||
                                        evidence.length > 0 ||
                                        record.notes
                                      ) && (

                                        <div class="metadata">

                                          {record.completed && (
                                            <span>
                                              ✓ Completado
                                            </span>
                                          )}

                                          {record.level > 0 && (
                                            <span>
                                              Nivel {record.level}/5
                                            </span>
                                          )}

                                          {record.study.status === "in-progress" && (
                                            <span>
                                              En progreso
                                            </span>
                                          )}

                                          {record.study.status === "review" && (
                                            <span>
                                              En revisión
                                            </span>
                                          )}

                                          {record.study.hours > 0 && (
                                            <span>
                                              {record.study.hours} h
                                            </span>
                                          )}

                                          {evidence.length > 0 && (
                                            <span>
                                              {evidence.length} evidencias
                                            </span>
                                          )}

                                        </div>

                                      )}


                                      {(
                                        record.study.startedAt ||
                                        record.study.completedAt
                                      ) && (

                                        <div class="dates">

                                          {record.study.startedAt && (
                                            <span>
                                              Inicio:
                                              {" "}
                                              {record.study.startedAt}
                                            </span>
                                          )}

                                          {record.study.completedAt && (
                                            <span>
                                              Fin:
                                              {" "}
                                              {record.study.completedAt}
                                            </span>
                                          )}

                                        </div>

                                      )}


                                      {evidence.length > 0 && (

                                        <div class="evidence">

                                          {evidence.map(
                                            (ev: any) => (

                                              <a
                                                href={
                                                  ev.url ?? "#"
                                                }
                                                target={
                                                  ev.url
                                                    ? "_blank"
                                                    : undefined
                                                }
                                                rel={
                                                  ev.url
                                                    ? "noopener noreferrer"
                                                    : undefined
                                                }
                                              >

                                                <small>
                                                  {ev.type}
                                                </small>

                                                <span>
                                                  {ev.title}
                                                </span>

                                                {ev.score !== undefined && (
                                                  <b>
                                                    {ev.score}%
                                                  </b>
                                                )}

                                              </a>

                                            )
                                          )}

                                        </div>

                                      )}


                                      {record.notes && (

                                        <div class="notes">

                                          <small>
                                            NOTAS
                                          </small>

                                          <p>
                                            {record.notes}
                                          </p>

                                        </div>

                                      )}

                                    </div>

                                  </article>

                                );

                              }
                            )}

                          </div>

                        </details>

                      );
                    }
                  )}

                </article>

              );
            }
          )}

        </section>
      );
    })}

  </div>
</section>


<style>

.horus-section {
  min-width: 100%;
  height: 100%;
  overflow-y: auto;
  overflow-x: hidden;
  scroll-behavior: smooth;
}

.horus-shell {
  width: min(1240px, calc(100% - 56px));
  margin: 0 auto;
  padding: 110px 0;
}

.horus-kicker,
.horus-label,
.horus-current > span,
.horus-stat > span,
.stage-progress > span,
.subject-header span {
  font-size: .67rem;
  font-weight: 800;
  letter-spacing: .16em;
  text-transform: uppercase;
  opacity: .55;
}

.horus-hero {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 300px;
  gap: 28px;
  margin-bottom: 30px;
}

.horus-hero h2 {
  margin: 10px 0 18px;
  font-size: clamp(2.5rem, 6vw, 5.8rem);
  line-height: .93;
  letter-spacing: -.065em;
}

.horus-lead {
  max-width: 800px;
  margin: 0;
  line-height: 1.8;
  opacity: .65;
}

.horus-current,
.horus-stat,
.horus-stage,
.subject {
  border: 1px solid rgba(127,127,127,.17);
  background: rgba(127,127,127,.04);
  backdrop-filter: blur(15px);
}

.horus-current {
  padding: 23px;
  border-radius: 20px;
}

.horus-current strong {
  display: block;
  margin-top: 8px;
  font-size: 1.7rem;
}

.horus-current p {
  margin-top: 9px;
  font-size: .8rem;
  line-height: 1.6;
  opacity: .6;
}

.horus-dashboard {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr;
  gap: 12px;
  margin-bottom: 70px;
}

.horus-stat {
  min-height: 135px;
  padding: 22px;
  border-radius: 18px;
}

.horus-stat strong {
  display: block;
  margin: 10px 0 5px;
  font-size: clamp(2rem, 4vw, 3.1rem);
  letter-spacing: -.05em;
}

.horus-stat small {
  opacity: .5;
}

.bar,
.stage-progress > div {
  height: 5px;
  margin-top: 13px;
  overflow: hidden;
  border-radius: 999px;
  background: rgba(127,127,127,.13);
}

.bar i,
.stage-progress i {
  display: block;
  height: 100%;
  border-radius: inherit;
  background: currentColor;
}

.horus-stage {
  margin-bottom: 60px;
  padding: 28px;
  border-radius: 24px;
}

.stage-header {
  display: grid;
  grid-template-columns: 54px minmax(0,1fr) 160px;
  gap: 18px;
  align-items: start;
  margin-bottom: 25px;
}

.stage-badge {
  display: grid;
  width: 54px;
  height: 54px;
  place-items: center;
  border: 1px solid rgba(127,127,127,.23);
  border-radius: 14px;
  font-weight: 900;
}

.stage-header h3 {
  margin: 7px 0;
  font-size: clamp(1.4rem,3vw,2.4rem);
  letter-spacing: -.04em;
}

.stage-header > div:nth-child(2) > p:last-child {
  max-width: 800px;
  margin: 0;
  line-height: 1.6;
  opacity: .58;
}

.stage-progress {
  padding: 13px;
  border: 1px solid rgba(127,127,127,.14);
  border-radius: 14px;
}

.stage-progress strong {
  display: block;
  margin: 5px 0 8px;
  font-size: 1.4rem;
}

.subject {
  margin-top: 12px;
  overflow: hidden;
  border-radius: 18px;
}

.subject-header {
  display: grid;
  grid-template-columns: minmax(0,1fr) 80px;
  gap: 20px;
  padding: 22px;
}

.subject-header h4 {
  margin: 6px 0;
  font-size: 1.25rem;
}

.subject-header p {
  max-width: 800px;
  margin: 0;
  font-size: .8rem;
  line-height: 1.6;
  opacity: .58;
}

.subject-header > strong {
  align-self: center;
  text-align: right;
}

.topic {
  border-top: 1px solid rgba(127,127,127,.12);
}

.topic summary {
  display: grid;
  grid-template-columns: minmax(0,1fr) 120px;
  gap: 15px;
  align-items: center;
  padding: 16px 20px;
  cursor: pointer;
  list-style: none;
}

.topic summary::-webkit-details-marker {
  display: none;
}

.topic summary:hover {
  background: rgba(127,127,127,.035);
}

.topic summary > div:first-child {
  display: flex;
  gap: 13px;
  align-items: center;
}

.topic summary > div:first-child > span {
  min-width: 70px;
  font-family: monospace;
  font-size: .61rem;
  opacity: .42;
}

.topic summary strong {
  font-size: .85rem;
}

.topic summary aside {
  display: flex;
  gap: 10px;
  justify-content: flex-end;
  align-items: center;
}

.topic summary aside small,
.topic summary aside b {
  font-size: .63rem;
  opacity: .5;
}

.topic summary aside i {
  font-size: 1.1rem;
  font-style: normal;
  opacity: .4;
}

.topic[open] summary aside i {
  transform: rotate(45deg);
}

.items {
  padding: 7px 20px 20px;
  background: rgba(127,127,127,.025);
}

.item {
  display: grid;
  grid-template-columns: 28px minmax(0,1fr);
  gap: 8px;
  padding: 10px 7px;
  border-radius: 8px;
}

.item:hover {
  background: rgba(127,127,127,.04);
}

.item.completed {
  opacity: .65;
}

.status {
  padding-top: 1px;
  text-align: center;
}

.status span {
  font-size: 1rem;
  font-weight: 900;
}

.pending .status span {
  opacity: .35;
}

.item-title {
  display: flex;
  gap: 10px;
  align-items: baseline;
}

.item-title code {
  min-width: 95px;
  font-family: monospace;
  font-size: .59rem;
  opacity: .42;
}

.item-title strong {
  font-size: .75rem;
  line-height: 1.45;
}

.metadata {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
  margin-top: 6px;
}

.metadata span {
  padding: 3px 7px;
  border: 1px solid rgba(127,127,127,.12);
  border-radius: 999px;
  font-size: .55rem;
  opacity: .5;
}

.dates {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 7px;
  font-size: .61rem;
  opacity: .43;
}

.evidence {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
  margin-top: 8px;
}

.evidence a {
  display: inline-flex;
  gap: 6px;
  align-items: center;
  padding: 5px 8px;
  color: inherit;
  text-decoration: none;
  border: 1px solid rgba(127,127,127,.14);
  border-radius: 999px;
  font-size: .59rem;
}

.evidence a:hover {
  border-color: rgba(127,127,127,.3);
}

.evidence small {
  text-transform: uppercase;
  opacity: .42;
}

.notes {
  margin-top: 8px;
  padding: 9px;
  border-left: 2px solid currentColor;
  background: rgba(127,127,127,.025);
}

.notes small {
  font-size: .56rem;
  letter-spacing: .12em;
  opacity: .45;
}

.notes p {
  margin: 5px 0 0;
  font-size: .7rem;
  line-height: 1.5;
  opacity: .6;
}

@media (max-width: 900px) {

  .horus-hero {
    grid-template-columns: 1fr;
  }

  .horus-dashboard {
    grid-template-columns: 1fr 1fr;
  }

  .horus-stat.main {
    grid-column: 1 / -1;
  }

  .stage-header {
    grid-template-columns: 50px 1fr;
  }

  .stage-progress {
    grid-column: 1 / -1;
  }

}

@media (max-width: 650px) {

  .horus-shell {
    width: calc(100% - 28px);
    padding: 80px 0;
  }

  .horus-dashboard {
    grid-template-columns: 1fr;
  }

  .horus-stat.main {
    grid-column: auto;
  }

  .horus-stage {
    padding: 18px;
  }

  .subject-header {
    grid-template-columns: 1fr;
  }

  .subject-header > strong {
    text-align: left;
  }

  .topic summary {
    grid-template-columns: 1fr;
  }

  .topic summary aside {
    justify-content: flex-start;
  }

  .item-title {
    display: block;
  }

  .item-title code {
    display: block;
    min-width: auto;
    margin-bottom: 3px;
  }

}
</style>


